Title Offset: The horizontal offset of the title in pixels. This can be used to adjust the position of the title relative to the top of the inventory GUI.\n- Texture Offset: The horizontal offset of the texture in pixels. This can be used to adjust the position of the texture relative to the top of the inventory GUI.\nThe last created inventory can be accessed using the 'Last Created Gui' expression.\nTo create an Inventory, you need a Texture, everything else is optional. See Examples for a demonstration.","syntax_pattern":"create [a] [new] [custom] (ia|itemsadder) [chest] inventory","compatible_addon_version":"1.5","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"skript-itemsadder","link_to_addon":"https://github.com/AsleeppMC/skript-itemsadder/releases","usage_score":13.5},"type_usage":"","return_type":"","event_values":"","json_id":"SecCreateCustomInventory","event_cancellable":false,"created_at":"2024-04-10T17:51:26.842808Z","updated_at":"2024-09-12T01:58:46.279914Z","entries":[{"name":"title","isRequired":false,"isSection":false,"defaultValue":"null"},{"name":"rows","isRequired":false,"isSection":false,"defaultValue":"3"},{"name":"texture","isRequired":true,"isSection":false,"defaultValue":"null"},{"name":"title offset","isRequired":false,"isSection":false,"defaultValue":"null"},{"name":"texture offset","isRequired":false,"isSection":false,"defaultValue":"null"}],"keywords":null,"mark_as_removed":false,"removed_since":null}]