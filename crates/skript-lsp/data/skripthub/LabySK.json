e":"event","get_syntax_type_css_class":"syntax_title_box_event","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":"","json_id":null,"event_cancellable":false,"created_at":"2024-05-04T19:40:34.977673Z","updated_at":"2025-01-04T10:42:03.068736Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":12539,"title":"Set marker send type","description":"Sets how the markers (when the player sends one) will be handled on the server.\r\n\r\nValid types:\r\n\r\nFRIENDS\r\nBLOCKED\r\n\r\nFRIENDS -> Normal behavior, the markers will be sent to all labymod friends of the player.\r\nBLOCKED -> No one on the server will recieve the marker even when they are friends with the player.","syntax_pattern":"set marker send type of %player% to %string%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-12-22T22:50:10.404434Z","updated_at":"2024-12-22T22:50:10.404456Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":12540,"title":"Send marker at location","description":"This Effect \"summons\" an marker at the given location on the server for everyone that has markers active in their options.\r\n\r\nParameters:\r\n%player% - The player that will recieve the summoned marker (Can also be loop-players)\r\n\r\n1st %integer% - The x-Position of the marker\r\n2nd %integer% - The y-Position of the marker\r\n3rd %integer% - The z-Position of the marker","syntax_pattern":"send marker to %player% at location %integer%, %integer%, %integer%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-12-22T22:52:29.441382Z","updated_at":"2024-12-22T22:52:29.441402Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11989,"title":"Create Input Prompt","description":"Create a LabyMod input prompt. This effect only creates the prompt and does not automatically open it for the player.\r\nIf another input prompt with the same ID is created the old one gets deleted.\r\n\r\nValid Colornames: BLACK, DARK\\_BLUE, DARK\\_GREEN, DARK\\_AQUA, DARK\\_RED, DARK\\_PURPLE, GOLD, GRAY, DARK\\_GRAY, BLUE, GREEN, AQUA, RED, LIGHT\\_PURPLE, YELLOW; WHITE\r\n\r\nValid Decoration: OBFUSCATED, BOLD, STRIKETHROUGH, UNDERLINED, ITALIC","syntax_pattern":"create new input prompt with id %string% with colorname %string%, decoration %string% and placeholder %string% with default value %string% and maximum length %integer%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-10-05T13:03:23.029010Z","updated_at":"2024-10-05T13:03:23.029033Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11990,"title":"Open Inputprompt","description":"Opens the input prompt with the specific id for the player if it was created before.","syntax_pattern":"open inputprompt with id %string% for %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-10-05T13:04:21.652046Z","updated_at":"2024-10-05T13:04:21.652065Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11991,"title":"Get Player Input","description":"Returns the input value after clicking the submit button of the input prompt. The value will be saved internally until the player sends another input or the server restarts / reloads.","syntax_pattern":"input of %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":"String","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-10-05T13:06:01.131828Z","updated_at":"2024-10-05T13:06:01.131851Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11461,"title":"Send to Server","description":"Sends the player to another server. The preview shows additional Informations like the Server's Server Icon and MOTD","syntax_pattern":"send %player% to server %string% titled %string%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-04T09:01:00.547633Z","updated_at":"2024-07-05T20:52:37.953669Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11463,"title":"Set Subtitle","description":"Sets the subtitle of the player to the given text and size.\nAccepted Sizes: 0.8 - 1.6 (0.8 Is Minecraft Default Size)","syntax_pattern":"set the subtitle of %player% to %string% with size %double% for %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-04T09:04:17.517200Z","updated_at":"2024-05-09T18:15:55.600276Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11459,"title":"Send playing gamemode","description":"Shows the playing gamemode to all LabyMod friends in the top right corner if activated in the player's profile settings.","syntax_pattern":"make %player% send playing gamemode with name %string%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-04T08:56:13.530770Z","updated_at":"2024-05-04T08:56:13.530789Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11462,"title":"Send Server Banner","description":"Sends a Server Banner to the player which is displayed over the Tablist.\r\nRecommended Resolution: 5:1 // 1280x256\r\nNote: You need to copy the picture address (which mostly ends with .png oder .jpeg)","syntax_pattern":"send server banner %string% to %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-04T09:03:28.080137Z","updated_at":"2024-05-04T09:03:28.080157Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11465,"title":"Set Economy display","description":"Sets the cash and bank display in the top right corner of the screen with a smooth transition for the player.","syntax_pattern":"set cash display to %integer% and bank display to %integer% for %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-04T19:39:44.193155Z","updated_at":"2024-05-04T19:39:44.193176Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11487,"title":"Create NPC","description":"Creates a valid NPC for playing LabyMod Emotes.\r\nThe created NPC is created via Citizens which means that it can be used with the features of the Citizens Plugin.\r\n\r\nNote: Every NPC needs to have an other ID!","syntax_pattern":"create npc with name %string% with skin of %string% with id %integer% at %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"j