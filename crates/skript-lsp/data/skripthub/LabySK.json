om the action menu for the player.\r\nThis Syntax ONLY ADDS actions. TO send actions to the player you need to use another syntax!!\r\nIt is important to use one of the following action types, otherwise it won't work:\r\n\r\nCLIPBOARD\r\nRUN\\_COMMAND\r\nSUGGEST\\_COMMAND\r\nOPEN\\_BROWSER\r\n\r\nThis Action also has an inbuilt detection for duplication of elements\r\n(Remove feature doesn't work for version 1.8 Sorry!)","syntax_pattern":"(add|remove) action with name %string% and value %string% as type %string% for %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-22T16:47:20.238169Z","updated_at":"2024-05-24T12:24:58.763846Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11560,"title":"Send country flag","description":"Sends the country flag from the given player to the other player(s). Will show in tablist and at above player's head the flag of their country.\r\n\r\n!! Doesn't work on localhost server !!","syntax_pattern":"send country flag from %player%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"LabySK","link_to_addon":"https://www.spigotmc.org/resources/labysk.116590/","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2024-05-18T14:49:55.529087Z","updated_at":"2024-07-05T20:38:26.848491Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11489,"title":"Play laby emote","description":"Plays the given LabyMod Emote for the NPC with giv