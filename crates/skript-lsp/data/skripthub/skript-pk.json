[{"id":13716,"title":"Bind Preset","description":"Binds a preset's abilities to a player.\nCan bind either player-specific presets or external presets.\nThe abilities will be bound to the player's hotbar in the order they were added to the preset.","syntax_pattern":"bind [player] preset %string% to %player%\nbind external preset %string% to %player%","compatible_addon_version":"1.5","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-pk","link_to_addon":"https://github.com/AnxeloK/skript-pk/releases","usage_score":76.6},"type_usage":"","return_type":"","event_values":"","json_id":"EffBindPreset","event_cancellable":false,"created_at":"2025-05-07T01:30:35.764333Z","updated_at":"2025-11-06T11:30:32.134301Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":13717,"title":"Bind ProjectKorra Ability","description":"Assigns a ProjectKorra bending ability to a specific hotbar slot (1-9) for a player. If no slot is specified, it uses the player's currently selected hotbar slot.","syntax_pattern":"bind ability %string% to %player% [slot %integer%]","compatible_addon_version":"1.5","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-pk","link_to_addon":"https://github.com/AnxeloK/skript-pk/releases","usage_score":76.6},"type_usage":"","return_type":"","event_values":"","json_id":"EffBindAbility","event_cancellable":false,"created_at":"2025-05-07T01:30:35.772164Z","updated_at":"2025-11-06T11:30:32.143995Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":13718,"title":"Clear ProjectKorra Ability Binding","description":"Removes any bending ability bound to a specified hotbar slot. If no slot number is given, clears the ability from the player's currently selected slot. Use this to remove unwanted abilities