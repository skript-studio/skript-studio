sion":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"Text","event_values":"","json_id":"ExprSlot2Key","event_cancellable":false,"created_at":"2025-11-11T05:38:25.646017Z","updated_at":"2025-11-11T05:38:25.646030Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14295,"title":"Slot Key from Menu","description":"The slot(s) of a specific key in a specific page of a menu.\nThis expression returns the slot(s) associated with the specified key in the specified page of the given menu.\nIf the key does not have any associated slots, it returns nothing.","syntax_pattern":"[the] slot[s] of [the] key %string% in [the] page %number% [of [the] menu %menu%]","compatible_addon_version":"1.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"Number","event_values":"","json_id":"ExprKey2Slot","event_cancellable":false,"created_at":"2025-11-11T05:38:25.653749Z","updated_at":"2025-11-11T05:38:25.653762Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14296,"title":"Create / Edit GUI","description":"The base of creating and editing GUIs.\nTips: This is a deprecated section, consider using EffSecCreateMenu and SecEditMenu instead.","syntax_pattern":"create [a] [new] gui [[with id[entifier]] %string%] with %inventory% [(and|with) ([re]move[e]able|stealable) items] [(and|with) shape %strings%]","compatible_addon_version":"1.0.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"","event_values":"","json_id":"SecCreateGUI","event_cancellable":false,"created_at":"2025-11-11T05:38:25.661773Z","updated_at":"2025-11-11T05:38:25.661787Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14297,"title":"Create Menu","description":"Create a menu.\nYou can define the menu's properties, such as its inventory type, title, id, layout, page, click delay, and whether to hide the player's inventory.\nYou can also define the menu's contents and behavior in the section below this effect.\nTips: If you do not specify a default page, the menu will insert a page 0 with the given layout and title.\nIf you create a menu with a id that already exists, the old one will be destroyed.","syntax_pattern":"create [a] [phantom|static] menu with %inventorytype% titled (%string%|%textcomponent%) with layout %strings% [with id %string%] [with page %number%] [with %number% ms click delay] [(with|without) hide player inventory)]","compatible_addon_version":"1.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"","event_values":"","json_id":"EffSecCreateMenu","event_cancellable":false,"created_at":"2025-11-11T05:38:25.669564Z","updated_at":"2025-11-11T05:38:25.669577Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14298,"title":"Edit Menu","description":"Edit an existing menu.\nYou can define the menu's contents and behavior in the section below this effect.","syntax_pattern":"(edit|change) [the] [(menu|gui)] %menu%","compatible_addon_version":"1.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type"