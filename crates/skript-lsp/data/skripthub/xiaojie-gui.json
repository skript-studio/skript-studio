resh' is specified, the player's gui will be refreshed to reflect the cleared session.","syntax_pattern":"clear [the] [menu] [session] %menusession% [and refresh]","compatible_addon_version":"1.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"","event_values":"","json_id":"EffClearSession","event_cancellable":false,"created_at":"2025-11-11T05:38:25.370137Z","updated_at":"2025-11-11T05:38:25.370151Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14261,"title":"Close Menu","description":"Close the menu for a player (if opened).","syntax_pattern":"(close|close down|shut) [the] (menu|gui) (for|to) %player%","compatible_addon_version":"1.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"","event_values":"","json_id":"EffCloseMenu","event_cancellable":false,"created_at":"2025-11-11T05:38:25.378539Z","updated_at":"2025-11-11T05:38:25.378553Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14262,"title":"Close Menu Session","description":"Closes a menu session, effectively closing the menu for the player.","syntax_pattern":"close [the] [menu] [session] %menusession%","compatible_addon_version":"1.0-SNAPSHOT","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"xiaojie-gui","link_to_addon":"https://github.com/heyhey123-git/xiaojie-gui/releases","usage_score":1.3},"type_usage":"","return_type":"","event_values":"","json_id"