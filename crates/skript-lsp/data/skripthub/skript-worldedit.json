using) %locations%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"World Edit Region","event_values":"","json_id":"ExprConvexPolyRegion","event_cancellable":false,"created_at":"2024-07-15T15:24:47.040271Z","updated_at":"2024-07-15T15:24:47.040285Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11776,"title":"Region - Cuboid","description":"Creates a cuboid region, which can be used for operations.","syntax_pattern":"[a] [new] [cuboid] region (between|within|from) %location% (and|to) %location%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"World Edit Region","event_values":"","json_id":"ExprCuboidRegion","event_cancellable":false,"created_at":"2024-07-15T15:24:47.050326Z","updated_at":"2024-07-15T15:24:47.050341Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11777,"title":"Region - Cylinder","description":"Creates a cylindrical region, which can be used for operations.","syntax_pattern":"[a] [new] cyl[ind(er|rical)] region at %location% with radi(i|us) %numbers% [and] with height %number%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"World Edit Region","event_values":"","