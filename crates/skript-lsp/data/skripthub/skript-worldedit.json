,"compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"RegionWrapper","event_cancellable":false,"created_at":"2024-07-15T15:24:47.122897Z","updated_at":"2024-07-15T15:24:47.122923Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11786,"title":"World Edit Shapes","description":"All the supported creatable shapes using WorldEdit.","syntax_pattern":"world[ ]edit[ ]shape[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"cylinder, ellipse, ellipsoid, pyramid, sphere","return_type":"","event_values":"","json_id":"WorldEditShape","event_cancellable":false,"created_at":"2024-07-15T15:24:47.131598Z","updated_at":"2024-07-15T15:24:47.131612Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11766,"title":"Region - Smooth","description":"Smooths the area within a given region a certain number of times. The default number of times is 1.\nYou can choose to only smooth blocks that match a certain mask.","syntax_pattern":"smooth [(blocks that match|all) %string/itemtype/worldeditmask% in] %worldeditregions% [%number% time[s]] [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffSmooth","event_cancellable":false,"created_at":"2024-07-15T15:24:46.965874Z","updated_at":"2024-07-26T00:41:17.996406Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11768,"title":"Set Blocks","description":"Sets the blocks in a region with a given pattern.","syntax_pattern":"(use ([fastasync]world[ ]edit|[fa]we) to|[fastasync]world[ ]edit|[fa]we) set [the] blocks in %worldeditregions% to [pattern] %string/itemtype/worldeditpattern% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffSet","event_cancellable":false,"created_at":"2024-07-15T15:24:46.982710Z","updated_at":"2024-07-26T00:41:18.019083Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11769,"title":"Shape - Cylinder","description":"Creates a cylinder using a given pattern at a certain location.\nYou can choose for the cylinder to be hollow, and it can take a set of radii and a height.\nBy default, the radius is 5, the height is 1, and the cylinder will not be hollow.","syntax_pattern":"create [a] [hollow] cylinder ([made] out of|with|using) [pattern] %string/itemtype/worldeditpattern% [with radi(us|i) %numbers%][,| and] [with height %number%] at %locations% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffCreateCylinder","event_cancellable":false,"created_at":"2024-07-15T15:24:46.990753Z","updated_at":"2024-07-26T00:41:18.027728Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11770,"title":"Shape - Pyramid","description":"Creates a pyramid using a given pattern at a certain location.\nYou can choose for the pyramid to be hollow, and it can take a size.\nBy default, the size is 5, and the pyramid will not be hollow.","syntax_pattern":"create [a] [hollow] pyramid ([made] out of|with|using) [pattern] %string/itemtype/worldeditpattern% [with size %number%] at %locations% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffCreatePyramid","event_cancellable":false,"created_at":"2024-07-15T15:24:46.998511Z","updated_at":"2024-07-26T00:41:18.035940Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11771,"title":"Shape - Sphere","description":"Creates a sphere using a given pattern at a certain location.\nYou can choose for the sphere to be hollow, and it can take a set of radii.\nBy default, the radius is 5, and the sphere will not be hollow.","syntax_pattern":"create [a] [hollow] (sphere|ellipsoid) ([made] out of|with|using) [pattern] %string/itemtype/worldeditpattern% [with radi(us|i) %numbers%] at %locations% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffCreateSphere","event_cancellable":false,"created_at":"2024-07-15T15:24:47.006818Z","updated_at":"2024-07-26T00:41:18.044015Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11787,"title":"Shape - General","description":"Creates a shape at a given location. Depending on which shape is being created, a different set of entries can be used.\n\nEntries that can be used with any shape:\n* pattern (pattern): the pattern that the shape will be made out of (no default, and this has to be a pattern object (via the pattern expression))\n* hollow (boolean): whether the shape will be hollow (default is true)\n\nEntries that can be used with a pyramid:\n* size (integer): the size of the pyramid (no default)\n\nEntries that can be used with both a sphere and cylinder:\n* radius (number): the radius (on the x-axis) of the shape (no default)\n* radiusZ (number): the radius (on the z-axis) of the shape (this is optional, and if not provided, will default to the radius)\n\nEntries that can be used only with a sphere:\n* radiusY (number): the radius (on the y-axis) of the shape (this is optional, and if not provided, will default to the radius)\n\nEntries that can be used only with a cylinder:\n* height (number): the height of the cylinder (no default)\n\nThis section is effectively the same as just using the shape effects, but might be preferable.","syntax_pattern":"create [a] %*worldeditshape% at %locations%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"SecCreateShape","event_cancellable":false,"created_at":"2024-07-15T15:24:47.139963Z","updated_at":"2024-07-15T15:24:47.139977Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11808,"title":"Region - Biome","description":"Sets the biome of given region.","syntax_pattern":"set biome of %worldeditregions% to %biome% [lazily]","compatible_addon_version":"1.0.3","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffBiome","event_cancellable":false,"created_at":"2024-07-26T00:41:17.900101Z","updated_at":"2024-07-26T00:41:17.900115Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11757,"title":"Region - Create Faces","description":"Creates the faces (walls + ceiling + floor) of a given region using a given pattern.","syntax_pattern":"(create|place|make|generate) [the] faces (of|around) %worldeditregions% ([made] out of|with|using) [pattern] %string/itemtype/worldeditpattern% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffFaces","event_cancellable":false,"created_at":"2024-07-15T15:24:46.885117Z","updated_at":"2024-07-26T00:41:17.907976Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11761,"title":"Region - Move","description":"Moves the blocks in a given region in a given direction a given distance.\nYou can choose to only move the blocks that match a given mask too, as well as filling the left-behind area using a certain pattern.\nAdditionally, air can be ignored, and entities and biomes can be copied.\n\nBy default, the distance will be 1, all blocks will be moved, no pattern will be left behind, air will not be ignored, and entities and biomes will not be copied.","syntax_pattern":"move [(blocks that match|all) %string/itemtype/worldeditmask% in] %worldeditregions% (up|down|north|south|east|west) [%number% (time|block)[s]] [and (fill the area with|leave behind) [pattern] %string/itemtype/worldeditpattern%] [while ignoring air[,]] [while copying entities[,| and]] [while copying biomes] [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffMove","event_cancellable":false,"created_at":"2024-07-15T15:24:46.922422Z","updated_at":"2024-07-26T00:41:17.942644Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11762,"title":"Region - Naturalize","description":"Naturalizes a given region. This just changes the top 3 layers of blocks into grass/dirt, and the bottom layers into stone.","syntax_pattern":"naturalize %worldeditregions% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffNaturalize","event_cancellable":false,"created_at":"2024-07-15T15:24:46.930951Z","updated_at":"2024-07-26T00:41:17.951585Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11763,"title":"Region - Overlay","description":"Overlays the top level of blocks in a given region using a given pattern.","syntax_pattern":"overlay [the] [top level of] blocks (in|of) %worldeditregions% (with|using) [pattern] %string/itemtype/worldeditpattern% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffOverlay","event_cancellable":false,"created_at":"2024-07-15T15:24:46.939344Z","updated_at":"2024-07-26T00:41:17.960937Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11765,"title":"Region - Regenerate","description":"Regenerates the area within a given region while optionally regenerating biomes, using a given seed.\nThe default seed is just the seed of the region's world, and biomes will not be regenerated by default.","syntax_pattern":"regen[erate] %worldeditregions% [with seed %number%] [while regen[erat]ing biomes] [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffRegenerate","event_cancellable":false,"created_at":"2024-07-15T15:24:46.954919Z","updated_at":"2024-07-26T00:41:17.981326Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11767,"title":"Replace Blocks","description":"Replaces blocks in a region that match a certain mask with a given pattern.","syntax_pattern":"(use ([fastasync]world[ ]edit|[fa]we) to|[fastasync]world[ ]edit|[fa]we) replace [all] blocks in %worldeditregion% that match [mask] %string/itemtype/worldeditmask% with [pattern] %string/itemtype/worldeditpattern% [lazily]\n(use ([fastasync]world[ ]edit|[fa]we) to|[fastasync]world[ ]edit|[fa]we) replace all %string/itemtype/worldeditmask% in %worldeditregion% with %string/itemtype/worldeditpattern% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffReplace","event_cancellable":false,"created_at":"2024-07-15T15:24:46.974345Z","updated_at":"2024-07-26T00:41:18.009059Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11809,"title":"Region - Dimensions","description":"Gets the dimensions of a given region.","syntax_pattern":"[the] region (height|length|width) of %worldeditregions%\n%worldeditregions%'[s] region (height|length|width)","compatible_addon_version":"1.0.2","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"Number","event_values":"","json_id":"ExprDimensions","event_cancellable":false,"created_at":"2024-07-26T00:41:18.052110Z","updated_at":"2024-07-26T00:41:18.052124Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11807,"title":"Create Spline","description":"Create a spline using a set of locations. The order of the locations in this effect matter.\nA rigid spline will create straight lines from location to location, whereas a non-rigid spline will createa curved line which goes through all the locations.","syntax_pattern":"(create|place|make|generate) [a] [hollow] [rigid|straight] (curve|spline|line) (with|using|from) %locations% (with|using) [pattern] %string/itemtype/worldeditpattern% [[and] with thickness %number%] [lazily]","compatible_addon_version":"1.0.3","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffSpline","event_cancellable":false,"created_at":"2024-07-26T00:41:17.887462Z","updated_at":"2025-09-15T09:51:32.067104Z","entries":null,"keywords":"","mark_as_removed":false,"removed_since":null},{"id":13985,"title":"Schematic - Exists","description":"Checks whether a schematic with a given name exists.","syntax_pattern":"schem[atic] %string% exists\nschem[atic] %string% does(n't| not) exist","compatible_addon_version":"1.1.3","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"CondSchematicExists","event_cancellable":false,"created_at":"2025-09-15T09:51:32.049890Z","updated_at":"2025-09-15T09:51:32.049913Z","entries":null,"keywords":"","mark_as_removed":false,"removed_since":null},{"id":11825,"title":"Schematic - Save","description":"Saves a region as a schematic.\nThe name of the schematic shouldn't include any path, as skript-worldedit will always start at WorldEdit's schematics directory.\nThe centre of the schematic can be set, as well as whether or not it should overwrite an existing schematic of the same name.","syntax_pattern":"save %worldeditregion% as [a] [schem[atic] (named|with name)] %string% [with [the] (cent(re|er)|origin) (at|of) %location%] [[and] overwrit(e|ing) existing]","compatible_addon_version":"1.1.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffSaveSchematic","event_cancellable":false,"created_at":"2024-08-01T16:44:44.055150Z","updated_at":"2025-09-15T09:51:32.076037Z","entries":null,"keywords":"","mark_as_removed":false,"removed_since":null},{"id":11963,"title":"Tree Types","description":"All the supported tree types that WorldEdit can use.","syntax_pattern":"[world[ ]edit[ ]]tree[ ]type[s]","compatible_addon_version":"1.1.2","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"acacia, azalea, big_tree, birch, brown_mushroom, cherry, chorus_plant, crimson_fungus, dark_oak, jungle, jungle_bush, mangrove, mega_redwood, pale_oak, pale_oak_creaking, pine, random, random_birch, random_jungle, random_mushroom, random_redwood, red_mushroom, redwood, short_jungle, small_jungle, swamp, tall_birch, tall_mangrove, tall_redwood, tree, warped_fungus","return_type":"","event_values":"","json_id":"TreeType","event_cancellable":false,"created_at":"2024-09-17T17:58:59.241695Z","updated_at":"2025-09-15T09:51:32.085134Z","entries":null,"keywords":"","mark_as_removed":false,"removed_since":null}]