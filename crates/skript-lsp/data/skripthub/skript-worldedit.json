[{"id":11812,"title":"Region - Expand/Contract","description":"Makes a region larger or smaller in a given direction by a given amount. Optionally takes an opposite amount to expand the region in the other direction.\nRegions can also be expanded vertically, which makes them span from the min to the max of the world they're in.","syntax_pattern":"(expand|contract) %worldeditregions% (up|down|north|south|east|west) [[by] %number% [blocks|times]] [and %number% [in opposite direction]]\nexpand %worldeditregions% vertically","compatible_addon_version":"1.0.4","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffExpandContract","event_cancellable":false,"created_at":"2024-07-29T05:10:35.228625Z","updated_at":"2024-07-29T05:10:35.228640Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11813,"title":"Region - Inset/Outset","description":"Insets or outsets a region by a given number of blocks. Can optionally only perform the operation vertically (up and down) or horizontally (north, south, east, and west).","syntax_pattern":"(in|out)set %worldeditregions% by %number% [blocks] [vertically|horizontally]","compatible_addon_version":"1.0.4","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffInsetOutset","event_cancellable":false,"created_at":"2024-07-29T05:10:35.237693Z","updated_at":"2024-07-29T05:10:35.237722Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11814,"title":"Region - Block Count","description":"Gets the number of a certain type of block in a region. Can use a mask to specify more than one kind of block.","syntax_pattern":"[the] (count|number) of blocks in %worldeditregions% that match [mask] %string/itemtype/worldeditmask%\n[the] (count|number) of %string/itemtype/worldeditmask% [blocks] in %worldeditregions%","compatible_addon_version":"1.0.4","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"Number","event_values":"","json_id":"ExprBlockCount","event_cancellable":false,"created_at":"2024-07-29T05:10:35.246515Z","updated_at":"2024-07-29T05:10:35.246529Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11826,"title":"Schematic - Paste","description":"Pastes a schematic, with a bunch of configurable options (see below for a list of them).\nNote that the name of the schematic shouldn't include any path, as skript-worldedit will always start at WorldEdit's schematics directory.\n\nEntries:\n* paste entities: whether the schematic should copy entities\n* paste biomes: whether the schematic should copy biomes\n* ignore air: whether the schematic should paste air blocks\n* rotation: the number of degrees that the pasted schematic should be rotated by (around the y-axis)\n* mask: a mask which will only let matching blocks be pasted","syntax_pattern":"paste [schem[atic] (named|with name)] %string% at %locations%","compatible_addon_version":"1.1.0","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"SecPasteSchematic","event_cancellable":false,"created_at":"2024-08-01T16:44:44.063061Z","updated_at":"2024-08-01T16:44:44.063076Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11827,"title":"Schematic - Save","description":"Saves a region as a schematic, with a bunch of configurable options (see below for a list of them).\nNote that the name of the schematic shouldn't include any path, as skript-worldedit will always start at WorldEdit's schematics directory.\n\nEntries:\n* copy entities: whether the schematic should copy entities\n* copy biomes: whether the schematic should copy biomes\n* remove entities: whether the schematic should remove entities\n* overwrite: whether the schematic should overwrite any schematics of the same name (if false, the schematic won't save if a schematic is found with the same name)\n* origin: where the origin of the saved schematic should be\n* mask: a mask which will only let matching blocks be copied","syntax_pattern":"save %worldeditregion% as [a] [schem[atic] (named|with name)] %string%","compatible_addon_version":"1.1.0","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"SecSaveSchematic","event_cancellable":false,"created_at":"2024-08-01T16:44:44.070756Z","updated_at":"2024-08-01T16:44:44.070770Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11961,"title":"Region - Forest","description":"Generates a forest of a specific tree type in a given region, with a given density. The default density is 5.\nNote that this effect uses a new tree type, not the Skript one.","syntax_pattern":"generate [a] %treetype% forest [with]in %worldeditregions% [with density %number%] [lazily]","compatible_addon_version":"1.1.2","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffForest","event_cancellable":false,"created_at":"2024-09-17T17:58:59.209125Z","updated_at":"2024-09-17T17:58:59.209146Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11962,"title":"Schematic - Delete","description":"Deletes a schematic. Nothing too fancy.","syntax_pattern":"delete schem[atic][s] [named|with name] %strings%","compatible_addon_version":"1.1.2","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffDeleteSchematic","event_cancellable":false,"created_at":"2024-09-17T17:58:59.222296Z","updated_at":"2024-09-17T17:58:59.222310Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11824,"title":"Schematic - Paste","description":"Pastes a schematic at a location(s). Can be rotated, and can choose whether it should ignore air or not.\nThere is also a section for pasting schematics, which features more options.","syntax_pattern":"paste [schem[atic] [named|with name]] %string% at %locations% [(with rotation|rotated by) %number% [degrees]] [[and] while ignoring air]","compatible_addon_version":"1.1.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffPasteSchematic","event_cancellable":false,"created_at":"2024-08-01T16:44:44.044422Z","updated_at":"2024-09-17T17:58:59.231575Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11764,"title":"Region - Place Centre","description":"Places a block in the centre of a given region using a given pattern.","syntax_pattern":"(create|place|make|generate) [a] block at [the] cent(re|er) of %worldeditregions% (with|using) [pattern] %string/itemtype/worldeditpattern% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffCenter","event_cancellable":false,"created_at":"2024-07-15T15:24:46.947089Z","updated_at":"2024-07-26T00:41:17.972028Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11758,"title":"Region - Create Walls","description":"Creates the walls of a given region using a given pattern.","syntax_pattern":"create [the] walls (of|around) %worldeditregions% ([made] out of|with|using) [pattern] %string/itemtype/worldeditpattern% [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffWalls","event_cancellable":false,"created_at":"2024-07-15T15:24:46.897529Z","updated_at":"2024-07-26T00:41:17.918410Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11759,"title":"Region - Flora","description":"Generates flora in a given region, with a given density. The default density is 5.","syntax_pattern":"(create|place|make|generate) flora [with]in %worldeditregions% [with density %number%] [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffFlora","event_cancellable":false,"created_at":"2024-07-15T15:24:46.905709Z","updated_at":"2024-07-26T00:41:17.926268Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11760,"title":"Region - Hollow Out","description":"Hollows out objects in a given region, using a given thickness and leaving behind a given pattern.\nThe default thickness is 1, and the default pattern is just air.","syntax_pattern":"hollow out %worldeditregions% [with thickness %number%] [and] [(with pattern|leaving behind) %string/itemtype/worldeditpattern%] [lazily]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"","event_values":"","json_id":"EffHollow","event_cancellable":false,"created_at":"2024-07-15T15:24:46.914227Z","updated_at":"2024-07-26T00:41:17.934541Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11772,"title":"Mask","description":"Gets a WorldEdit mask from a string or itemtype.","syntax_pattern":"mask (of|from|that matches) %string/itemtype%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","u