xpression can only be used on convex polyhedral regions.","syntax_pattern":"[the] region vert(ices|exes) of %worldeditregion%\n[the] %worldeditregion%'[s] vert(ices|exes)","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"Location","event_values":"","json_id":"ExprVertices","event_cancellable":false,"created_at":"2024-07-15T15:24:47.082502Z","updated_at":"2024-07-15T15:24:47.082517Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11781,"title":"Region - Volume","description":"Gets the volume of a given region.","syntax_pattern":"[the] region volume of %worldeditregions%\n%worldeditregions%'[s] region volume","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit","link_to_addon":"https://github.com/cheeezburga/SkWE/releases","usage_score":19.4},"type_usage":"","return_type":"Number","event_values":"","json_id":"ExprVolume","event_cancellable":false,"created_at":"2024-07-15T15:24:47.090426Z","updated_at":"2024-07-15T15:24:47.090441Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":11782,"title":"Region - Walls","description":"Gets the walls of a given region. This expression only works on cuboid regions.\nThis returns another region, which can be used in other operations.","syntax_pattern":"[the] [region] walls of %worldeditregion%\n%worldeditregion%'[s] [region] walls","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-worldedit