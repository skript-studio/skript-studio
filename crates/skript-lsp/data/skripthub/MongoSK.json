[{"id":14818,"title":"Mongo document has key?","description":"Checks if the documents contains the specified key.","syntax_pattern":"mongo[(sk|db)] document[s] %mongoskdocuments% ((has|contains)|doesn't (have|contain)) key [named] %string%","compatible_addon_version":"2.1.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondMongoDocHasKey","event_cancellable":false,"created_at":"2026-04-25T20:13:11.783185Z","updated_at":"2026-04-25T20:13:11.783205Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14819,"title":"Mongo document has value?","description":"Checks if the documents contains the specified value.","syntax_pattern":"mongo[(sk|db)] document[s] %mongoskdocuments% ((has|contains)|doesn't (have|contain)) value %integer/number/string/boolean/mongoskdocument%","compatible_addon_version":"2.1.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondMongoDocHasValue","event_cancellable":false,"created_at":"2026-04-25T20:13:11.793544Z","updated_at":"2026-04-25T20:13:11.793558Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14820,"title":"Mongo document is empty?","description":"Checks if the document is empty (if it contains no keys or values).","syntax_pattern":"mongo[(sk|db)] document[s] %mongoskdocuments% (is|are)[((n't| not))] empty","compatible_addon_version":"2.1.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondMongoDocIsEmpty","event_cancellable":false,"created_at":"2026-04-25T20:13:11.800676Z","updated_at":"2026-04-25T20:13:11.800690Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14821,"title":"Create Mongo collection","description":"Quickly create a collection with a specific name in one of your databases. Make sure it does not exist first.","syntax_pattern":"create [a] mongo[(sk|db)] collection [named] %string% in %mongoskdatabase%","compatible_addon_version":"2.0.3","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffCreateMongoCollection","event_cancellable":false,"created_at":"2026-04-25T20:13:11.807765Z","updated_at":"2026-04-25T20:13:11.807778Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14822,"title":"Manage Mongo document","description":"Firstly, you can insert your Mongo document in the collection you want, with an automatically generated unique identifier if not specified or already existing. This will not replace existing documents with the same identifier, but will insert a new one. Secondly, if you want to replace the document, you can use the replace syntax. Finally, to remove the document, simply use remove. This effect is only a shortcut and simply executes a query with \"_id\" as the unique identifier. If you have changed the unique ID field, you should not use this effect.","syntax_pattern":"(insert|(replace|update)|remove) mongo[(sk|db)] doc[ument][s] %mongoskdocuments% (in[to]|of|from) [collection] %mongoskcollection%","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffManageMongoDocument","event_cancellable":false,"created_at":"2026-04-25T20:13:11.814599Z","updated_at":"2026-04-25T20:13:11.814612Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14823,"title":"Mongo section document value","description":"This effect can only be used in a Mongo section document, and allows quick assignment of fields to a given document. Be aware that this syntax is only available for basic data manipulation. If your manipulation is not possible via this section, you can perfectly well use the classic field definition expression in addition to this section.","syntax_pattern":"mongo[(sk|db)] [((field|value)|(array|list))] %string%\\: %objects%","compatible_addon_version":"2.1.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"SectMongoValue","event_cancellable":false,"created_at":"2026-04-25T20:13:11.821541Z","updated_at":"2026-04-25T20:13:11.821554Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14824,"title":"All Mongo collections","description":"Quickly retrieve all the collections contained in a Mongo database.","syntax_pattern":"[all] [the] mongo[(db|sk)] collections of %mongoskdatabase%\n[all] %mongoskdatabase%'[s] mongo[(db|sk)] collections","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Collection","event_values":"","json_id":"ExprAllMongoCollections","event_cancellable":false,"created_at":"2026-04-25T20:13:11.828528Z","updated_at":"2026-04-25T20:13:11.828542Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14825,"title":"All Mongo databases","description":"Quickly retrieve all the databases contained in a Mongo server.","syntax_pattern":"[all] [the] mongo[(db|sk)] databases of %mongoskserver%\n[all] %mongoskserver%'[s] mongo[(db|sk)] databases","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Database","event_values":"","json_id":"ExprAllMongoDatabases","event_cancellable":false,"created_at":"2026-04-25T20:13:11.835439Z","updated_at":"2026-04-25T20:13:11.835452Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14826,"title":"Mongo Embedded Value","description":"It is sometimes redundant to extract a document from a document from a document etc... and undertake several data manipulations on several lines. To remedy this, this expression will only ask you the path (MongoSK specific syntax, be careful) as follows: \"foo.bar\", or \"foo[0].bar\" or \"foo.bar[2]\" for example. Embedded documents must be separated by a dot, and you must specify in brackets the index of the array (starting from 0) if it is a list.","syntax_pattern":"mongo[(sk|db)] embedded ((field|value)|(array|list)) [with path] %string% of %mongoskdocument%","compatible_addon_version":"2.3.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Object","event_values":"","json_id":"ExprMongoEmbeddedValue","event_cancellable":false,"created_at":"2026-04-25T20:13:11.843871Z","updated_at":"2026-04-25T20:13:11.843885Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14827,"title":"Mongo collection","description":"Retrieve a specific collection via its name from a database on your Mongo server. You must specify the database where your collection is located.","syntax_pattern":"[the] mongo[(sk|db)] collection [named] %string% (of|from) %mongoskdatabase%","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Collection","event_values":"","json_id":"ExprMongoCollection","event_cancellable":false,"created_at":"2026-04-25T20:13:11.850835Z","updated_at":"2026-04-25T20:13:11.850848Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14828,"title":"Mongo collection document count","description":"If you want to know the number of documents in a collection, you should use this expression. Please note that this is an estimate.","syntax_pattern":"[the] mongo[(db|sk)] estimated doc[ument][s] count of %mongoskcollections%\n%mongoskcollections%'[s] mongo[(db|sk)] estimated doc[ument][s] count","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"integer","event_values":"","json_id":"ExprMongoCollectionDocCount","event_cancellable":false,"created_at":"2026-04-25T20:13:11.857819Z","updated_at":"2026-04-25T20:13:11.857833Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14829,"title":"Mongo command result","description":"This expression is very useful and gives complete freedom to use your database with MongoSK. Indeed, it allows to execute any command to a database, which will return the documents to you. You are therefore no longer dependent on the features of MongoSK, and you can use any commands. To learn more about the possible commands, see: https://docs.mongodb.com/manual/reference/command/.","syntax_pattern":"(results|documents) of mongo[(sk|db)] command %string% (of|in) database %mongoskdatabase%","compatible_addon_version":"2.0.3","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Document","event_values":"","json_id":"ExprMongoCommandResult","event_cancellable":false,"created_at":"2026-04-25T20:13:11.866438Z","updated_at":"2026-04-25T20:13:11.866452Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14830,"title":"Mongo database","description":"Retrieve a specific database from a Mongo server. You must specify in which Mongo server your collection is located.","syntax_pattern":"[the] mongo[(sk|db)] database [named] %string% (of|from) %mongoskserver%","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Database","event_values":"","json_id":"ExprMongoDatabase","event_cancellable":false,"created_at":"2026-04-25T20:13:11.873579Z","updated_at":"2026-04-25T20:13:11.873592Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14831,"title":"Mongo database name of a collection","description":"Retrieves the name of the database to which the collection belongs. You can then use the expression to retrieve a database by its name if you wish.","syntax_pattern":"[the] mongo[(sk|db)] database name of %mongoskcollections%\n%mongoskcollections%'[s] mongo[(sk|db)] database name","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Text","event_values":"","json_id":"ExprMongoCollectionDatabase","event_cancellable":false,"created_at":"2026-04-25T20:13:11.880533Z","updated_at":"2026-04-25T20:13:11.880546Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14832,"title":"Mongo distinct query","description":"The distinct query is useful when you want to retrieve a specific field from each document in a given collection. For example, if you have documents with a \"name\" field, you can use this expression to retrieve all the \"name\" fields of the documents in the collection. Useful, isn't it?This expression does not accept constructed queries because there is no need to use it. They can only be used with the find query.","syntax_pattern":"(first|all) mongo[(sk|db)] field[s] distincted by [field] %string% [(with|by) [filter] %mongoskfilter%] (of|from) collection %mongoskcollection%","compatible_addon_version":"2.2.1","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Object","event_values":"","json_id":"ExprMongoDisctinctResult","event_cancellable":false,"created_at":"2026-04-25T20:13:11.887969Z","updated_at":"2026-04-25T20:13:11.887982Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14833,"title":"Mongo document JSON","description":"Retrieve the JSON representation of the document. This expression can be useful to use it with skript-json and convert the document to a Skript variable, and vice versa. You can also define the JSON of the document.","syntax_pattern":"[the] mongo[(db|sk)] json of %mongoskdocuments%\n%mongoskdocuments%'[s] mongo[(db|sk)] json","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Text","event_values":"","json_id":"ExprMongoDocumentJson","event_cancellable":false,"created_at":"2026-04-25T20:13:11.896109Z","updated_at":"2026-04-25T20:13:11.896122Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14834,"title":"Mongo document field","description":"This expression is extremely important because it allows you to manage the values and lists of your documents. You can define lists, add items to lists, set values, or delete them. If Skript adapters are enabled, you can specify any type of data, and they will be automatically transformed by MongoSK so that they can be registered. So you can store players, blocks, items for example.","syntax_pattern":"mongo[(sk|db)] ((field|value)|(array|list)) [named] %string% of %mongoskdocument%","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Object","event_values":"","json_id":"ExprMongoDocumentField","event_cancellable":false,"created_at":"2026-04-25T20:13:11.903342Z","updated_at":"2026-04-25T20:13:11.903355Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14835,"title":"Mongo document keys","description":"With this expression, retrieve all the keys of a document. The expression returns a list of text.","syntax_pattern":"mongo[(sk|db)] keys of [document] %mongoskdocument%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Text","event_values":"","json_id":"ExprMongoKeys","event_cancellable":false,"created_at":"2026-04-25T20:13:11.910710Z","updated_at":"2026-04-25T20:13:11.910724Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14836,"title":"Mongo document values","description":"With this expression, retrieve all the values of a document. The expression returns a list of different data types.","syntax_pattern":"mongo[(sk|db)] values of [document] %mongoskdocument%","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Object","event_values":"","json_id":"ExprMongoValues","event_cancellable":false,"created_at":"2026-04-25T20:13:11.917514Z","updated_at":"2026-04-25T20:13:11.917527Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14837,"title":"Mongo filter","description":"Create custom Mongo filters to target a certain type of data in your queries to your collections.The comparators are the same as for Skript.","syntax_pattern":"[[a] new] mongo[(db|sk)] filter [where] field %string% is ((greater|more|higher|bigger|larger|above) [than] or (equal to|the same as)|\\>=) %integer/number%\n[[a] new] mongo[(db|sk)] filter [where] field %string% is (((greater|more|higher|bigger|larger) than|above)|\\>) %integer/number%\n[[a] new] mongo[(db|sk)] filter [where] field %string% is ((less|smaller|below) [than] or (equal to|the same as)|\\<=) %integer/number%\n[[a] new] mongo[(db|sk)] filter [where] field %string% is (((less|smaller) than|below)|\\<) %integer/number%\n[[a] new] mongo[(db|sk)] filter [where] field %string% is ((not|neither)|isn't|!=) [equal to] %object%\n[[a] new] mongo[(db|sk)] filter [where] field %string% (is|equals|=) %object%\n[[a] new] mongo[(db|sk)] filter [where] field %string% (does(n't| not) exist|is not (set|defined))\n[[a] new] mongo[(db|sk)] filter [where] field %string% (exists|is (set|defined))","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Filter","event_values":"","json_id":"ExprMongoFilter","event_cancellable":false,"created_at":"2026-04-25T20:13:11.924359Z","updated_at":"2026-04-25T20:13:11.924372Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14838,"title":"Mongo find query","description":"Use this expression if you want to make simple find requests, easily and quickly. To do so, you must specify the type of your query: are you looking for several documents or the first document in the collection? Then, the first means is to use a filter to specify the type of data you are looking for. Finally, you need to specify where the query should ask for the data, i.e. in which collection.The second way is to specify a Mongo request that you will have built beforehand. This will allow you to better specify your request and create a more complex one.You also have the possibility to modify already existing documents and delete documents, in the same way as for making your queries.","syntax_pattern":"[find] (first|all) mongo[(sk|db)] document[s] [(with|by) [filter] %mongoskfilter%] (of|from) collection %mongoskcollection%\n[find] (first|all) mongo[(sk|db)] document[s] (of|from) query %mongoskquery%","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Document","event_values":"","json_id":"ExprMongoFindResult","event_cancellable":false,"created_at":"2026-04-25T20:13:11.931630Z","updated_at":"2026-04-25T20:13:11.931643Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14839,"title":"Mongo joined filters","description":"Thanks to this expression, you will be able to combine two filters to refine your queries. Several types of filter comparison are possible, and, or, and nor.","syntax_pattern":"mongo[(sk|db)] joined filters %mongoskfilter% (and|or|nor) %mongoskfilter%\nmongo[(sk|db)] joined filters %mongoskfilters% with (and|or|nor) [join] mode","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Filter","event_values":"","json_id":"ExprMongoJoinedFilters","event_cancellable":false,"created_at":"2026-04-25T20:13:11.938780Z","updated_at":"2026-04-25T20:13:11.938794Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14840,"title":"Mongo joined sorts","description":"Thanks to this expression, you will be able to combine two sorts to refine your queries.","syntax_pattern":"mongo[(sk|db)] joined sorts %mongosksorts%","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"MongoSK Sort","event_values":"","json_id":"ExprMongoJoinedSorts","event_cancellable":false,"created_at":"2026-04-25T20:13:11.945810Z","updated_at":"2026-04-25T20:13:11.945823Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14841,"title":"Mongo name","description":"Retrieve the names of different Mongo elements. You can use this expression to retrieve the name of collections or databases.","syntax_pattern":"[the] mongo[(db|sk)] name[s] of %mongoskdatabases/mongoskcollections%\n%mongoskdatabases/mongoskcollections%'[s] mongo[(db|sk)] name[s]","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romitou/MongoSK","usage_score":0},"type_usage":"","return_type":"Text","event_values":"","json_id":"ExprMongoName","event_cancellable":false,"created_at":"2026-04-25T20:13:11.952884Z","updated_at":"2026-04-25T20:13:11.952897Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":14842,"title":"Mongo query collection","description":"Defines the collection in which the query will run.","syntax_pattern":"[the] mongo[(db|sk)] collection of %mongoskqueries%\n%mongoskqueries%'[s] mongo[(db|sk)] collection","compatible_addon_version":"2.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"MongoSK","link_to_addon":"https://github.com/Romi