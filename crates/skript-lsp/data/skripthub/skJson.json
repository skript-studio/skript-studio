498,"title":"Prepare Web requests","description":"allowed methods are [GET, POST, PUT, HEAD, MOCK, DELETE, PATCH]\nallowed value type of content is Json or stringify json (Json as String) e.g. \"{\"\"Test\"\": true}\"\nallowed value type of header is Json or (Pairs e.g. \"Content-Type: application/Json\", \"Allow: restrict\")\n\nYou can execute the request by 'send prepared {_request}', otherwise the request will be not sent, but the request will be still stored\nAnd you can get response status/content/headers like in the examples","syntax_pattern":"[skjson] prepare %requestmethod% request on %string%","compatible_addon_version":"2.9.9-pre API changes 5.0 - change Response.API","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skJson","link_to_addon":"https://github.com/SkJsonTeam/skJson","usage_score":4.6},"type_usage":"","return_type":"request","event_values":"","json_id":"ExprSimpleRequest","event_cancellable":false,"created_at":"2025-04-23T22:24:08.947925Z","updated_at":"2025-04-23T22:35:02.479771Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":13713,"title":"body of request/response","description":"set/reset or get the current request body\nget response body","syntax_pattern":"[the] body of %requests/responses%\n%requests/responses%'[s] body","compatible_addon_version":"2.9.9-pre Api Changes 5.1","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skJson","link_to_addon":"https://github.com/SkJsonTeam/skJson","usage_score":4.6},"type_usage":"","return_type":"Object","event_values":"","json_id":"ExprSimpleBody","event_cancellable":false,"created_at":"2025-05-05T15:24:46.046761Z","updated_at":"2025-05-05T15:24:46.046776Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":13714,"title"