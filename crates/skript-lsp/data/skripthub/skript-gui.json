[{"id":7914,"title":"Has GUI","description":"Checks whether the given player(s) has/have a GUI open.","syntax_pattern":"%players% (has|have) a gui [open]\n%players% (doesn't|does not|do not|don't) have a gui [open]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-gui","link_to_addon":"https://github.com/APickledWalrus/skript-gui/releases","usage_score":11.9},"type_usage":"","return_type":"","event_values":"","json_id":"CondHasGUI","event_cancellable":false,"created_at":"2022-08-11T19:03:33.413183Z","updated_at":"2022-08-11T19:03:33.413202Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":7915,"title":"Cancel GUI Close","description":"Cancels or uncancels the closing of a GUI.\n This effect can be used within a GUI close section.\n A 1 tick delay is applied by this effect after the code has run.","syntax_pattern":"(cancel|uncancel) [the] gui clos(e|ing)","compatible_addon_version":"1.2.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-gui","link_to_addon":"https://github.com/APickledWalrus/skript-gui/releases","usage_score":11.9},"type_usage":"","return_type":"","event_values":"","json_id":"EffCancelGUIClose","event_cancellable":false,"created_at":"2022-08-11T19:03:33.431953Z","updated_at":"2022-08-11T19:03:33.431965Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":7916,"title":"ExprGUIs","description":"","syntax_pattern":"all guis","compatible_addon_version":"","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-gui","link_to_addon":"https://github.com/APickledWalrus/skript-gui/releases","usage_score":11.9},"type_usage":"","return