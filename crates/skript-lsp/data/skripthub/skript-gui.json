","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"skript-gui","link_to_addon":"https://github.com/APickledWalrus/skript-gui/releases","usage_score":11.9},"type_usage":"","return_type":"","event_values":"","json_id":"SecGUIOpenClose","event_cancellable":false,"created_at":"2022-08-11T19:06:21.092111Z","updated_at":"2022-08-11T19:06:21.092122Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":7930,"title":"Set GUI Slots","description":"Set or clear GUI slots.","syntax_pattern":"(make|format) [the] next gui [slot] (with|to) [removable:([re]mov[e]able|stealable)] %itemtype%\n(make|format) gui [slot[s]] %strings/numbers% (with|to) [removable:([re]mov[e]able|stealable)] %itemtype%\n(un(make|format)|remove) [the] next gui [slot]\n(un(make|format)|remove) gui [slot[s]] %strings/numbers%\n(un(make|format)|remove) all [[of] the] gui [slots]","compatible_addon_version":"1.0.0, 1.2.0 (making specific slots stealable)","compatible_minecraft_version":"","syntax_type":"section","get_syntax_type_css_class":"syntax_title_box_section","required_plugins":[],"addon":{"name":"skript-gui","link_to_addon":"https://github.com/APickledWalrus/skript-gui/releases","usage_score":11.9},"type_usage":"","return_type":"","event_values":"","json_id":"SecMakeGUI","event_cancellable":false,"created_at":"2022-08-11T19:06:21.100442Z","updated_at":"2022-08-11T19:06:21.100453Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":7917,"title":"GUI Properties","description":"Different properties of a GUI. They can be modified.","syntax_pattern":"[the] ([skript-]gui name[s]|([skript-]gui size[s]|rows)|shape[s]|lock status[es]) of %guiinventorys%\n%guiinventorys%'[s] ([skript-gui] name[s]|(size[s]|rows)|shape[s]|lock status[es])","compatible_addon_version":"1.0.0, 1.3 (rework, support outside of edit sections), 1.3.2 (\"gui\" keyword for name and size)","compatible_minecraft_version":"","syntax_type