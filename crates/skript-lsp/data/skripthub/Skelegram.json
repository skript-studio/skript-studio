[{"id":9217,"title":"Telegram Sender of Message","description":"The sender of a Telegram Message.","syntax_pattern":"sender of %telegrammessage%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Telegram User","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:26:42.064720Z","updated_at":"2023-05-06T09:26:42.064734Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9192,"title":"Telegram Bot Login","description":"Create a session and authenticate to a telegram bot, given its username and its token.","syntax_pattern":"telegram login to bot %string% with token %string%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:47:51.395260Z","updated_at":"2023-05-06T07:47:51.395271Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9193,"title":"Clear all telegram sessions","description":"Close all the telegram sessions that are active. Stops any running bot. You should use this in case you get an api error 409 saying multiple instances are running a single bot. Please note that closing a session may take up to 50 seconds, as it is delayed by the Telegram API itself.","syntax_pattern":"(clear|stop) all telegram sessions","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:48:24.265922Z","updated_at":"2023-05-06T07:48:24.265933Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9197,"title":"Telegram Message","description":"This type holds all the information about a message. You can either get this object in a telegram event (event-telegram message) or by creating a new one (new telegram message with text %string%)","syntax_pattern":"%telegrammessage%\nevent-telegram message\ntelegram message","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":".","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:53:24.937403Z","updated_at":"2023-05-06T07:53:24.937414Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9198,"title":"Telegram Chat","description":"This type holds all the information about a telegram chat.","syntax_pattern":"%telegramchat%\nevent-telegram chat\ntelegram chat","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":"type of %telegramchat%\r\nid of %telegramchat%","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:53:59.935707Z","updated_at":"2023-05-06T07:53:59.935723Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9200,"title":"Telegram Inline Keyboard","description":"This type represents a Telegram Inline Keyboard. A keyboard is a matrix of buttons (double list). You can access the rows of the keyboard with the row expression.","syntax_pattern":"%inlinekeyboard%\ninline keyboard","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":"1st row of keyboard %inlinekeyboard%\r\ninline keyboard of %telegrammessage%","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:55:46.327639Z","updated_at":"2023-05-06T07:55:46.327650Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9201,"title":"Telegram Inline Button","description":"This type represents a Telegram Inline Button. You can't add simply the button to a message, but you need first to add it into a keyboard. You can then add the keyboard to the message. (Otherwise, how would Telegram know which position the button would have to be?)\r\n\r\nOf a button, you can define its text (the displayed button itself) and its action. If you set its URL, it will open automatically a link when clicked. If you set its callback data, you can specify the data that is sent to the bot when clicked. You can listen to such data with the EvtCallbackQuery","syntax_pattern":"%inlinebutton%\ninline button","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":"text of %inlinebutton%\r\ncallback data of %inlinebutton%\r\nurl of %inlinebutton%","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:56:14.191124Z","updated_at":"2023-05-06T07:56:14.191136Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9202,"title":"Telegram Message Event","description":"Fires whenever a message (or command) is received. You can access the received message with event-telegram message","syntax_pattern":"on telegram message [event]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"event","get_syntax_type_css_class":"syntax_title_box_event","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":"event-telegram message\r\nevent-telegram bot","json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:58:04.009881Z","updated_at":"2023-05-06T07:58:04.009898Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9203,"title":"Telegram CallbackQuery Event","description":"Fires whenever a button with a callback data is fired. You can specify for which data to listen or leave it blank to listen for any button press","syntax_pattern":"on [telegram] callback query [[with data] %string%]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"event","get_syntax_type_css_class":"syntax_title_box_event","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":"event-callback query\r\nevent-telegram user\r\nevent-telegram message\r\nevent-telegram bot","json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:59:26.368250Z","updated_at":"2023-05-06T07:59:26.368263Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9204,"title":"Callback Query","description":"This type represents a Callback Query. A callback query is what the bot receives when an inline button is pressed. You can see for example the callback data of the button with callback data of %callbackquery%","syntax_pattern":"%callbackquery%\ncallback query","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":"event-callback query","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T08:06:13.270212Z","updated_at":"2023-05-06T08:06:13.270224Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9205,"title":"New Telegram Message","description":"Returns a new empty telegram message. You can use other expressions to change its properties, such as text, keyboard, etc. You may use this outside of a Telegram Event, but in order to send it you'll have to specify bot you are using.","syntax_pattern":"new telegram message with text %string%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Telegram Message","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T08:14:25.597673Z","updated_at":"2023-05-06T08:14:25.597688Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9206,"title":"Last Telegram Sent Message","description":"Returns the last sent message. Use this exclusively and immediately after sending a message.","syntax_pattern":"[the] last sent telegram message [with bot %string%]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Telegram Message","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T08:21:17.418057Z","updated_at":"2023-05-06T08:21:17.418070Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9207,"title":"Telegram Chat of Message","description":"Returns a Telegram Chat type. The chat in which a message has been sent. Can not be set.","syntax_pattern":"chat of %telegrammessage%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Telegram Chat","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:08:30.616023Z","updated_at":"2023-05-06T09:08:30.616038Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9208,"title":"Telegram Text of Message","description":"Returns the text of a telegram message. Can be changed to edit the message.","syntax_pattern":"text of %telegrammessage%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Telegram Message","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:08:57.736941Z","updated_at":"2023-05-06T09:08:57.736955Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9195,"title":"Send telegram message","description":"Send a telegram message. The message can be a string or can be an existing message. The target chat ID can be used to specify the destination of the message. If used inside of a Telegram Event, the bot to use is automatically detected. To use it outside of a Telegram Event, specify the username of the bot. If a session exists for that bot, the message will be sent.","syntax_pattern":"send telegram message %string/telegrammessage% [with markdown] to %telegramuser/telegramchat/number% [with bot %string%]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:49:38.150604Z","updated_at":"2023-05-08T16:33:52.750753Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9196,"title":"Reply telegram message","description":"Send a telegram message, as a reply to another message. The reply message can be a string or can be an existing message. If used inside of a Telegram Event, the bot to use is automatically detected. To use it outside of a Telegram Event, specify the username of the bot. If a session exists for that bot, the message will be sent.","syntax_pattern":"reply to telegram message %telegrammessage% with %telegrammessage/string% [with markdown] [with bot %-string%]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:50:22.374590Z","updated_at":"2023-05-08T16:34:55.927702Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9209,"title":"Telegram Id","description":"Returns the Numeric ID of a telegram object. Each user has an unique ID. The ID of a chat is identic to a user ID if it's its private chat with the bot. (It is different if it's a group or supergroup etc.). Each message has an unique ID inside of a chat. Can't be set.","syntax_pattern":"id of %telegrammessage%\nid of %telegramuser%\nid of %telegramchat%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Integer","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:09:43.016954Z","updated_at":"2023-05-06T09:09:43.016969Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9210,"title":"Telegram Chat Type","description":"Returns the type of a telegram chat. It can be \"PRIVATE\", \"BOT\", \"GROUP\", \"SUPERGROUP\" or \"CHANNEL\". Can't be set.","syntax_pattern":"type of %telegramchat%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"String (\"PRIVATE\", \"BOT\", \"GROUP\", \"SUPERGROUP\", \"CHANNEL\")","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:13:03.351570Z","updated_at":"2023-05-06T09:13:03.351581Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9211,"title":"Callback Data of InlineButton","description":"The callback data of an Inline Button. This is the text that is sent to the bot on a button press, and it can be listened for with the On Callback Query event.","syntax_pattern":"callback data of %inlinebutton%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"String","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:19:52.627941Z","updated_at":"2023-05-06T09:19:52.627952Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9212,"title":"Callback Data of CallbackQuery","description":"The callback data of a Callback Query. You can use this to check what telegram button was pressed, based on the callback data you had set.","syntax_pattern":"callback data of %callbackquery%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"String","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:20:37.854231Z","updated_at":"2023-05-06T09:20:37.854245Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9213,"title":"Text of InlineButton","description":"The Displayed text of an Inline Button. This is the actual message a button has in the chat.","syntax_pattern":"text of %inlinebutton%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"String","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:24:12.516350Z","updated_at":"2023-05-06T09:24:12.516361Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9214,"title":"Url of InlineButton","description":"The URL of an Inline Button. Note that a button can't have both a callback data and an URL. The link will be opened on button press.","syntax_pattern":"url of %inlinebutton%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"String","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:24:46.119813Z","updated_at":"2023-05-06T09:24:46.119824Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9215,"title":"Row of InlineKeyboard","description":"The row of an existing InlineKeyboard. You can add, remove, set and clear rows. Setting a row that doesn't exist on the keyboard will simply append it to the bottom.","syntax_pattern":"[the] %number%(st|nd|rd|th) row of [the] [inline] keyboard %inlinekeyboard%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"List of Telegram Buttons","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:25:23.753720Z","updated_at":"2023-05-06T09:25:23.753737Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9216,"title":"Inline Keyboard of Message","description":"The Inline Keyboard of a Telegram Message. You can use this to add a keyboard to existing messages, before sending them.","syntax_pattern":"inline keyboard of %telegrammessage%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":"Inline Keyboard","event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T09:26:04.409378Z","updated_at":"2023-05-06T09:26:04.409391Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9199,"title":"Telegram User","description":"This type represents a Telegram User.","syntax_pattern":"%telegramuser%\nevent-telegram user\ntelegram user","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":"id of %telegramuser%","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:54:33.197678Z","updated_at":"2023-05-06T09:40:18.874345Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9194,"title":"Clear Telegram Session","description":"Closes the telegram session of a specific bot. Please note that closing a session may take up to 50 seconds, as it is delayed by the Telegram API itself.","syntax_pattern":"(clear|stop) telegram session of bot %string%","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-06T07:49:11.732951Z","updated_at":"2023-05-06T12:11:15.944822Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9219,"title":"Telegram Bot","description":"This type represents a telegram bot. It holds information about the bot that fired a spefific event. You can view its username (to check if the bot is the one you're creating in skript) with \"%username of event-telegram bot%\" or with \"%event-telegram bot%\" Since Telegram Events are fired by all bots ran on a server, you should always filter that the received event is fired by the bot you're programming.","syntax_pattern":"%telegram bot%\ntelegram bot","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":"event-telegram bot","return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-08T10:22:12.893503Z","updated_at":"2023-05-08T10:22:12.893515Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9220,"title":"Answer to Callback Query","description":"Show a little notification to a user after they pressed a button. This will also complete a button press, removing the little clock that shows on the button when it gets pressed. Adding \"with popup\" will show the callback query answer in a popup window, and the user will have to press OK to hide it.","syntax_pattern":"answer to callback query %callbackquery% with %string% [with popup]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-08T10:24:48.465102Z","updated_at":"2023-05-08T10:24:48.465113Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9221,"title":"Forward Telegram Message","description":"Forward an existing telegram message, and send it to a user. The final message will have information about who sent it in the first place. It will show \"forwarded from\" to its top.","syntax_pattern":"forward telegram message %telegrammessage% to %telegramuser/telegramchat/number% [with bot %string%]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-05-08T10:25:19.293244Z","updated_at":"2023-05-08T10:25:19.293257Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":9222,"title":"Copy Telegram Message","description":"Copy an existing telegram message, and send it to a user. This is useful for storing messages sent by the bot, eg. media or other. A copied message will not have \"forwarded from\" to its top.","syntax_pattern":"copy telegram message %telegrammessage% to %telegramuser/telegramchat/number% [with bot %string%]","compatible_addon_version":"1.0-ALPHA","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"Skelegram","link_to_addon":"https://github.com/DereWah/Skelegram/releases","us