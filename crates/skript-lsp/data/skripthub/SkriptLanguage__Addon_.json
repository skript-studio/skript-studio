[{"id":8185,"title":"get Synonyms of Word","description":"Gets the synonyms of a word and stores them.\r\nCan get multiple results, storing in a non-list variable/metadata tag will store only 1 of the results.","syntax_pattern":"(get|load) [the] synonym[s] of %string% and (store|save) [(it|them)] in %-objects%\"","compatible_addon_version":"1.1.0+","compatible_minecraft_version":"1.19.2","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"SkriptLanguage (Addon)","link_to_addon":"https://github.com/J-ak-e/SkriptLanguage-Addon","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2022-11-01T07:44:02.712847Z","updated_at":"2022-11-01T07:44:02.712865Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":8184,"title":"get Definition of Word","description":"Gets the definition of a word and stores it.","syntax_pattern":"(get|load) [the] definition of %string% and (store|save) [it] in %-objects%","compatible_addon_version":"1.1.0+","compatible_minecraft_version":"1.19.2","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"SkriptLanguage (Addon)","link_to_addon":"https://github.com/J-ak-e/SkriptLanguage-Addon","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2022-11-01T07:41:53.557330Z","updated_at":"2022-11-01T07:41:53.557348Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":8186,"title":"get Antonyms of Word","description":"Gets the antonyms (or opposites) of a word and stores them.\r\nCan get multiple results, storing in a non-list variable/metadata tag will store only 1 of the results.","syntax_pattern":"(get|load) [the] antonym[s] of %string% and (store|save) [(it|them)] in %-objects%","compatible_addon_version":"1.1.0+","compatible_minecraft_version":"1.19.2","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"SkriptLanguage (Addon)","link_to_addon":"https://github.com/J-ak-e/SkriptLanguage-Addon","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2022-11-01T07:45:13.449186Z","updated_at":"2022-11-01T07:45:13.449204Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":8514,"title":"get Random Word","description":"Get a random word.\nDue to api limitations you cannot retrieve a set amount of non english words, non english words with a set length or specify both amount and length.\nWill send a warning if used to inform about this limitation, to disable the warning simply go to 'plugins/SkriptLanguage/config.yml', set 'randomWordWarning' to false, save and run /skriptlanguage (which is the config reload command as of 1.2.0).","syntax_pattern":"(get|load) [a[n]|%-number%] random [(:spanish|:chinese|:italian|:german|english)] word[s] [with (length|size) %-number%] (and (store|save) [(it|them)] in|to) %-objects%","compatible_addon_version":"1.2.0","compatible_minecraft_version":"1.19.2","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"SkriptLanguage (Addon)","link_to_addon":"https://github.com/J-ak-e/SkriptLanguage-Addon","usage_score":1},"type_usage":null,"return_type":null,"event_values":null,"json_id":null,"event_cancellable":false,"created_at":"2023-01-30T02:06:13.021074Z","updated_at":"2023-01-30T02:06:38.370837Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null}]