[{"id":3555,"title":"Hologram Height","description":"Returns the physical height of a hologram.","syntax_pattern":"[the] [physical] height[s] of [holo[gram][s]] %holograms%\n%holograms%'[s] [physical] height[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Number","event_values":"","json_id":"ExprHologramHeight","event_cancellable":false,"created_at":"2019-02-19T19:50:12.420964Z","updated_at":"2019-05-05T22:28:52.498548Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3534,"title":"Hologram Allows Placeholders","description":"Checks whether the given hologram allows placeholders.","syntax_pattern":"[holo[gram][s]] %holograms% (allow|disallow)[s] placeholders\nplaceholders (in|for) [holo[gram][s]] %holograms% are (enabled|disabled)\n[holo[gram][s]] %holograms% (doesn't|does not|don't|do not) (allow|disallow) placeholders\nplaceholders (in|for) [holo[gram][s]] %holograms% (aren't|are not) (enabled|disabled)","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondHologramAllowsPlaceholders","event_cancellable":false,"created_at":"2019-02-19T19:50:12.265198Z","updated_at":"2019-05-05T22:28:52.368729Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3535,"title":"Is Following Hologram","description":"Checks whether the given hologram is a following hologram.","syntax_pattern":"[holo[gram][s]] %holograms% (is|are) [a] following [holo[gram][s]]\n[holo[gram][s]] %holograms% (isn't|is not|aren't|are not) [a] following [holo[gram][s]]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsFollowingHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.272670Z","updated_at":"2019-05-05T22:28:52.375289Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3536,"title":"Is Hologram Deleted","description":"Checks whether the given hologram is deleted. When you delete a hologram that is stored in a variable, the hologram object will still exist in the variable but will not be usable. This condition exists to check this case.","syntax_pattern":"holo[gram][s] %holograms% (is|are) (deleted|removed|cleared)\nholo[gram][s] %holograms% (isn't|is not|aren't|are not) (deleted|removed|cleared)","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsHologramDeleted","event_cancellable":false,"created_at":"2019-02-19T19:50:12.280031Z","updated_at":"2019-05-05T22:28:52.381465Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3532,"title":"On Hologram Line Touch","description":"Called while a player is trying to pickup an item in a hologram line. See the `Make Hologram Line Touchable` effect.","syntax_pattern":"[on] holo[gram] [line] touch","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"event","get_syntax_type_css_class":"syntax_title_box_event","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"event-player, event-hologramline, event-hologram, event-itemtype","json_id":"hologram_line_touch","event_cancellable":false,"created_at":"2019-02-19T19:50:12.249148Z","updated_at":"2019-05-05T22:28:52.355101Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3531,"title":"On Hologram Line Click","description":"Called when a player clicks on a hologram line. See the `Make Hologram Line Click-able` effect.","syntax_pattern":"[on] holo[gram] [line] click","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"event","get_syntax_type_css_class":"syntax_title_box_event","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"event-player, event-hologramline, event-hologram","json_id":"hologram_line_click","event_cancellable":false,"created_at":"2019-02-19T19:50:12.212636Z","updated_at":"2019-05-05T22:28:52.289184Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3553,"title":"Following Holograms of Entity","description":"Returns the following holograms of an entity. Use the `Following Hologram` effect to make an exiting hologram start/stop following an entity.","syntax_pattern":"[all] [the] following holo[gram]s of %entities%\n[all] [the] holo[gram]s (following|that follows) %entities%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Hologram","event_values":"","json_id":"ExprEntityFollowingHolograms","event_cancellable":false,"created_at":"2019-02-19T19:50:12.406536Z","updated_at":"2019-05-05T22:28:52.487143Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3547,"title":"Hologram Visibility","description":"Changes visibility of a hologram for the given players or makes a hologram invisible/visible by default. Resetting hologram visibility means setting the visibility to the default value (visible if not changed).","syntax_pattern":"hide [holo[gram][s]] %holograms% (from|for) %players%\nreveal [holo[gram][s]] %holograms% (to|for|from) %players%\nreset [the] visibilit(y|ies) of [holo[gram][s]] %holograms% [for %players%]\n(make|let) [holo[gram][s]] %holograms% (invisible|hidden) by default\n(make|let) [holo[gram][s]] %holograms% visible by default","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":null,"return_type":null,"event_values":null,"json_id":"EffHologramVisibility","event_cancellable":false,"created_at":"2019-02-19T19:50:12.361177Z","updated_at":"2019-05-22T17:16:12.668005Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3543,"title":"Allow Placeholders in Hologram","description":"Allows/disallows placeholders in a hologram. Disallowed by default.","syntax_pattern":"(allow|enable) [the] placeholders (in|for) [holo[gram][s]] %holograms%\n(disallow|disable) [the] placeholders (in|for) [holo[gram][s]] %holograms%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffAllowPlaceholdersInHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.331648Z","updated_at":"2019-05-05T22:28:52.422585Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3537,"title":"Is Hologram Entity","description":"Checks whether the given entity is a part of a hologram. It is not possible to get the hologram.","syntax_pattern":"%entities% (is|are) [[a] part[s] of] [a] holo[gram] [entit(y|ies)]\n%entities% (isn't|is not|aren't|are not) [[a] part[s] of] [a] holo[gram] [entit(y|ies)]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsHologramEntity","event_cancellable":false,"created_at":"2019-02-19T19:50:12.287349Z","updated_at":"2019-05-05T22:28:52.387353Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3538,"title":"Is Hologram Line Click-able","description":"Checks whether the given hologram line is click-able.","syntax_pattern":"[holo[gram] line[s]] %hologramlines% (is|are) [((un|non[-]))]click[-]able\n[holo[gram] line[s]] %hologramlines% (isn't|is not|aren't|are not) [((un|non[-]))]click[-]able","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsHologramLineClickable","event_cancellable":false,"created_at":"2019-02-19T19:50:12.295037Z","updated_at":"2019-05-05T22:28:52.393636Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3539,"title":"Is Hologram Line Touchable","description":"Checks whether the given hologram line is touchable.","syntax_pattern":"[holo[gram] line[s]] %hologramlines% (is|are) [((non[-]|un))]touch[-]able\n[holo[gram] line[s]] %hologramlines% (isn't|is not|aren't|are not) [((non[-]|un))]touch[-]able","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsHologramLineTouchable","event_cancellable":false,"created_at":"2019-02-19T19:50:12.302272Z","updated_at":"2019-05-05T22:28:52.399420Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3540,"title":"Is Hologram Visible by Default","description":"Checks whether the given hologram is visible by default.","syntax_pattern":"[holo[gram][s]] %holograms% (is|are) (visible|(invisible|hidden)) by default\n[holo[gram][s]] %holograms% (isn't|is not|aren't|are not) (visible|(invisible|hidden)) by default","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsHologramVisibleByDefault","event_cancellable":false,"created_at":"2019-02-19T19:50:12.309499Z","updated_at":"2019-05-05T22:28:52.405022Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3541,"title":"Is Text/Item Line","description":"Checks whether the given hologram line is a text line or an item line. The `Hologram Line Content` expression can be used to get the text or the item.","syntax_pattern":"[holo[gram] line[s]] %hologramlines% (is|are) [a[n]] ((text|string)|item) line[s]\n[holo[gram] line[s]] %hologramlines% (isn't|is not|aren't|are not) [a[n]] ((text|string)|item) line[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondIsHologramLineTextItem","event_cancellable":false,"created_at":"2019-02-19T19:50:12.316426Z","updated_at":"2019-05-05T22:28:52.410924Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3542,"title":"Add Hologram Line","description":"Adds new lines to a hologram. `insert` means adding after the specified line and moving the next lines below.","syntax_pattern":"append [((click|touch|interact)[-]able|interactive)] [line[s]] %strings/itemtypes% to [holo[gram][s]] %holograms%\nprepend [((click|touch|interact)[-]able|interactive)] [line[s]] %strings/itemtypes% to [holo[gram][s]] %holograms%\ninsert [((click|touch|interact)[-]able|interactive)] [line[s]] %strings/itemtypes% in[to] [holo[gram][s]] %holograms% at line %number%\ninsert [((click|touch|interact)[-]able|interactive)] [line[s]] %strings/itemtypes% in[to] [holo[gram][s]] %holograms% at [the] %number%(st|nd|rd|th) line","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffAddHologramLine","event_cancellable":false,"created_at":"2019-02-19T19:50:12.324524Z","updated_at":"2019-05-05T22:28:52.416676Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3545,"title":"Delete Hologram","description":"Deletes a hologram. The hologram type has the delete changer already, but this effect exists for variables. For example `delete {_holo}` would delete the variable but you can use `delete hologram {_holo}` to avoid that.\n\nWhen you delete a hologram that is stored in a variable, the hologram object will still exist in the variable but will not be usable. You should delete the variable too in this case.","syntax_pattern":"(delete|remove|clear) holo[gram][s] %holograms%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffDeleteHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.345907Z","updated_at":"2019-05-05T22:28:52.434505Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3546,"title":"Following Hologram","description":"Makes a hologram start/stop following an entity.","syntax_pattern":"(make|let) [holo[gram][s]] %holograms% (start following|follow) %entity% [[with] offset [(of|by|in|to)] [[the] direction] %directions%]\n(make|let) [holo[gram][s]] %holograms% (stop following|unfollow)","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffFollowingHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.353255Z","updated_at":"2019-05-05T22:28:52.440401Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3549,"title":"Teleport Hologram","description":"Teleports a hologram to a specific location.","syntax_pattern":"teleport [holo[gram][s]] %holograms% (to|%direction%) %location%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffTeleportHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.376972Z","updated_at":"2019-05-05T22:28:52.462790Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3550,"title":"All Holograms","description":"Returns all the holograms created by skript-holo or other plugins *except HolographicDisplays*.","syntax_pattern":"[all] [the] holo[gram]s [([created] by|of|under|from) skript-holo]\n[all] [the] holo[gram]s ([created] by|of|under|from) [the] [plugin[s]] %strings%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Hologram","event_values":"","json_id":"ExprHolograms","event_cancellable":false,"created_at":"2019-02-19T19:50:12.384499Z","updated_at":"2019-05-05T22:28:52.469249Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3551,"title":"Followed Entity of Hologram","description":"Returns the followed entity of a hologram. Use the `Following Hologram` effect to make an exiting hologram start/stop following an entity.","syntax_pattern":"[the] followed entit(y|ies) (of|by) [holo[gram][s]] %holograms%\n[the] entit(y|ies) followed by [holo[gram][s]] %holograms%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Entity","event_values":"","json_id":"ExprFollowedEntityByHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.391970Z","updated_at":"2019-05-05T22:28:52.475430Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3552,"title":"Following Hologram Offset","description":"Returns offset (directions) of a following hologram. Can be set.","syntax_pattern":"[the] [following] offset[s] of [holo[gram][s]] %holograms%\n%holograms%'[s] [following] offset[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Direction","event_values":"","json_id":"ExprFollowingHologramOffset","event_cancellable":false,"created_at":"2019-02-19T19:50:12.399309Z","updated_at":"2019-05-05T22:28:52.481303Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3554,"title":"Hologram Creation Date","description":"Returns the creation date of a hologram.","syntax_pattern":"[the] (creation|spawned) date[s] of [holo[gram][s]] %holograms%\n%holograms%'[s] (creation|spawned) date[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Date","event_values":"","json_id":"ExprHologramCreationDate","event_cancellable":false,"created_at":"2019-02-19T19:50:12.413576Z","updated_at":"2019-05-05T22:28:52.492870Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3562,"title":"Hologram Line","description":"A line of a HolographicDisplays hologram. Can be deleted using the 'delete/clear' changer.\n\nHas converters to `text`, `item type` and `number`. Converters mean that you can use this type like the converted types. For example you can do `give line 1 of hologram to player` and `if event-hologram-line is 5:`, but please note that getting line number of a hologram line will check every line of the hologram. You shouldn't make systems that relies on line numbers, but contents.","syntax_pattern":"holo[gram][( |-)]line[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":null,"event_values":null,"json_id":"HologramLine","event_cancellable":false,"created_at":"2019-02-19T19:50:12.476179Z","updated_at":"2019-05-05T22:46:10.632608Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3560,"title":"Parent Hologram of Hologram Line","description":"Returns the parent hologram of a hologram line.","syntax_pattern":"[the] [parent[s]] holo[gram][s] of [holo[gram] line[s]] %hologramlines%\n%hologramlines%'[s] [parent[s]] holo[gram][s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Hologram","event_values":"","json_id":"ExprHologramLineParent","event_cancellable":false,"created_at":"2019-02-19T19:50:12.459857Z","updated_at":"2019-05-05T22:28:52.532312Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3533,"title":"Can See Hologram","description":"Checks whether the given players can see the given holograms. Use the `Hologram Visibility` effect to hide/show holograms.","syntax_pattern":"[holo[gram][s]] %holograms% (is|are) (visible|(invisible|hidden)) (for|to|from) %players%\n%players% can see [holo[gram][s]] %holograms%\n[holo[gram][s]] %holograms% (is|are)(n't| not) (visible|(invisible|hidden)) (for|to|from) %players%\n%players% can('t| not) see [holo[gram][s]] %holograms%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"condition","get_syntax_type_css_class":"syntax_title_box_condition","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"CondCanSeeHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.256648Z","updated_at":"2019-05-05T22:28:52.361419Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3544,"title":"Create Hologram","description":"Creates a new hologram.\n\nBesides the `store in %variable%`, the `Last Created Hologram` expression can be used to get the created hologram.","syntax_pattern":"(create|spawn) [a] [new] holo[gram] [with [((click|touch|interact)[-]able|interactive)] line[s] %strings/itemtypes%] [%direction% %location%] [and store [it] in [[the] variable] %objects%]\n(create|spawn) [a] [new] holo[gram] [with [((click|touch|interact)[-]able|interactive)] line[s] %strings/itemtypes%] that follows %entity% [[with] offset [(of|by|in|to)] [[the] direction] %directions%] [and store [it] in [[the] variable] %objects%]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffCreateHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.338896Z","updated_at":"2019-05-05T22:28:52.428648Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3548,"title":"Make Hologram Line Click-able/Touchable","description":"Makes a hologram line click-able or/and touchable. \n\n- **Click-able:** when a player clicks on the line, the `Hologram Line Click` event will be triggered\n- **Touchable:** when a player tries to pickup the item in the line, the `Hologram Line Touch` event will be triggered\n- **Interactive:** includes both click-able and touchable","syntax_pattern":"(make|let) [holo[gram] line[s]] %hologramlines% [((un|non[-]))]click[-]able\n(make|let) [holo[gram] line[s]] %hologramlines% [((un|non[-]))]touch[-]able\n(make|let) [holo[gram] line[s]] %hologramlines% [((non[-]|un))](interactive|interact[-]able)","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"effect","get_syntax_type_css_class":"syntax_title_box_effect","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"EffMakeHologramLineInteractive","event_cancellable":false,"created_at":"2019-02-19T19:50:12.368476Z","updated_at":"2019-05-05T22:28:52.456434Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3556,"title":"Hologram Line Content","description":"Returns content (text or item) of a hologram line. Please note that there are hologram line to text and item converters so you can use a hologram line like a text or an item (e.g. give first line of holo to player)","syntax_pattern":"[the] (content|(text|string)|item)[s] (of|in) [holo[gram] line[s]] %hologramlines%\n%hologramlines%'[s] (content|(text|string)|item)[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Object","event_values":"","json_id":"ExprHologramLineContent","event_cancellable":false,"created_at":"2019-02-19T19:50:12.428814Z","updated_at":"2019-05-05T22:28:52.504513Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3557,"title":"Hologram Line Number","description":"Returns the number of a hologram line. But please note that getting line number of a hologram line will check every line of the hologram. You shouldn't make systems that relies on line numbers, but contents.","syntax_pattern":"[the] line number[s] of [holo[gram] line[s]] %hologramlines%\n%hologramlines%'[s] line number[s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Number","event_values":"","json_id":"ExprHologramLineNumber","event_cancellable":false,"created_at":"2019-02-19T19:50:12.435977Z","updated_at":"2019-05-05T22:28:52.510477Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3558,"title":"Hologram Lines","description":"Returns lines of a hologram. Can be changed, removing a text or an item means it will search lines that match exactly with the input and remove them.\n\nIt is possible to create new lines using the `set` changer, for example if the hologram has 3 lines and you set line 5, the line 4 will be blank.","syntax_pattern":"[all] [the] lines of [holo[gram][s]] %holograms%\n%holograms%'[s] [all] lines\n[the] line %number% of [holo[gram][s]] %holograms%\n[the] %number%(st|nd|rd|th) line[s] of [holo[gram][s]] %holograms%\n[the] (first|last) line[s] of [holo[gram][s]] %holograms%","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Hologram Line","event_values":"","json_id":"ExprHologramLines","event_cancellable":false,"created_at":"2019-02-19T19:50:12.443945Z","updated_at":"2019-05-05T22:28:52.516480Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3559,"title":"Last Created Hologram","description":"Holds the hologram that was created most recently with the `Create Hologram` effect.\nCan be deleted using the `delete/clear` changer which means the hologram will be removed from the world and this expression will be empty.","syntax_pattern":"[the] [last[ly]] [(created|spawned)] holo[gram]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"expression","get_syntax_type_css_class":"syntax_title_box_expression","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"Hologram","event_values":"","json_id":"ExprLastCreatedHologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.451702Z","updated_at":"2019-05-05T22:28:52.526491Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null},{"id":3561,"title":"Hologram","description":"A HolographicDisplays hologram. Can be deleted using the `delete/clear` changer or can be reset using the `reset` changer. When you delete a hologram that is stored in a variable, the hologram object will still exist in the variable but will not be usable. You should delete the variable too in this case.","syntax_pattern":"holo[gram][s]","compatible_addon_version":"1.0.0","compatible_minecraft_version":"","syntax_type":"type","get_syntax_type_css_class":"syntax_title_box_type","required_plugins":[],"addon":{"name":"skript-holo","link_to_addon":"https://github.com/Blueyescat/skript-holo","usage_score":0},"type_usage":"","return_type":"","event_values":"","json_id":"Hologram","event_cancellable":false,"created_at":"2019-02-19T19:50:12.467605Z","updated_at":"2019-05-05T22:28:52.538416Z","entries":null,"keywords":null,"mark_as_removed":false,"removed_since":null}]