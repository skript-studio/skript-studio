*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
nul

# IDE
.idea/
.vscode/
*.iml

# Local environment overrides
.env
.env.local

# Logs and runtime artifacts
*.log
stderr.log
stdout.log

# SkriptHub corpus: per-addon files under crates/skript-lsp/data/skripthub/
# and the aggregate crates/skript-registry/testdata/skripthub.json are
# deliberately git-TRACKED (embedded at build time) — do NOT ignore them.
# Legacy output path of normalize-cache.mjs (pre-retarget); never commit.
crates/skript-lsp/data/skripthub-cache.json

# Tauri sidecar binary (built by scripts/build-sidecar.ps1)
apps/skript-studio-ui/src-tauri/skript-lsp-*.exe
.secrets/
